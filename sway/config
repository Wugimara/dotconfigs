input type:touchpad {
    tap enabled
    dwt enabled
    accel_profile "flat"
    pointer_accel .25
    drag enabled
    # dwt_timeout 500
}

### Key bindings
#
# This section defines keybindings for various Sway actions.
# Read `man 5 sway-input` for more information on keybindings.

# --- Basic actions ---
# Start a terminal
bindsym $mod+Return exec $term
# Kill focused window
bindsym $mod+Shift+q kill
# Start application launcher (Rofi)
bindsym $mod+d exec $menu
# Reload Sway configuration
bindsym $mod+Shift+c reload
# Exit Sway (logout)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# --- Moving focus ---
# Focus with Mod+Ctrl+Shift+Arrow
# bindsym $mod+Ctrl+Left focus left
# bindsym $mod+Ctrl+Down focus down
# bindsym $mod+Ctrl+Up focus up
# bindsym $mod+Ctrl+Right focus right
bindsym $mod+Tab+Left focus left
bindsym $mod+Tab+Down focus down
bindsym $mod+Tab+Up focus up
bindsym $mod+Tab+Right focus right
bindsym $mod+Tab+$Left focus left
bindsym $mod+Tab+$Down focus down
bindsym $mod+Tab+$Up focus up
bindsym $mod+Tab+$Right focus right

# --- Moving windows ---
# Move windows with Shift + arrow keys
bindsym $mod+Left move left
bindsym $mod+Down move down
bindsym $mod+Up move up
bindsym $mod+Right move right
bindsym $mod+$Left move left
bindsym $mod+$Down move down
bindsym $mod+$Up move up
bindsym $mod+$Right move right

# --- Resizing windows ---
# Resize focused window with Mod+Ctrl+Arrow
bindsym $mod+Ctrl+Left resize shrink width 10px
bindsym $mod+Ctrl+Right resize grow width 10px
bindsym $mod+Ctrl+Up resize shrink height 10px
bindsym $mod+Ctrl+Down resize grow height 10px
bindsym $mod+Ctrl+$Left resize shrink width 10px
bindsym $mod+Ctrl+$Right resize grow width 10px
bindsym $mod+Ctrl+$Up resize shrink height 10px
bindsym $mod+Ctrl+$Down resize grow height 10px

### Workspaces
 
set $workcolumn 1
set $row 1

# === MOD + NUM: Set column + go to $$workcolumn$$row + normalize ===
bindsym $mod+1 set $$workcolumn 1; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+2 set $$workcolumn 2; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+3 set $$workcolumn 3; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+4 set $$workcolumn 4; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+5 set $$workcolumn 5; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+6 set $$workcolumn 6; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+7 set $$workcolumn 7; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+8 set $$workcolumn 8; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
bindsym $mod+9 set $$workcolumn 9; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh
# bindsym $mod+0 set $$workcolumn 10; workspace $$workcolumn$$row; exec  ~/.config/sway/scripts/normalize-grid.sh

# === SWIPES (only source of truth) ===
bindgesture swipe:3:left  exec  "~/.config/sway/scripts/focus-next-col.sh  && ~/.config/sway/scripts/normalize-grid.sh"
bindgesture swipe:3:right exec  "~/.config/sway/scripts/focus-prev-col.sh && ~/.config/sway/scripts/normalize-grid.sh"
bindgesture swipe:3:up    exec  "~/.config/sway/scripts/focus-next-row.sh    && ~/.config/sway/scripts/normalize-grid.sh"
bindgesture swipe:3:down  exec  "~/.config/sway/scripts/focus-prev-row.sh  && ~/.config/sway/scripts/normalize-grid.sh"

# Move container to previous/next workspace
bindsym $mod+Shift+Up     exec ~/.config/sway/scripts/send-prev-row.sh
bindsym $mod+Shift+Down   exec ~/.config/sway/scripts/send-next-row.sh
bindsym $mod+Shift+left   exec ~/.config/sway/scripts/send-prev-col.sh
bindsym $mod+Shift+right   exec ~/.config/sway/scripts/send-next-col.sh
bindsym $mod+Shift+$Up     exec ~/.config/sway/scripts/send-prev-row.sh
bindsym $mod+Shift+$Down   exec ~/.config/sway/scripts/send-next-row.sh
bindsym $mod+Shift+$Left   exec ~/.config/sway/scripts/send-prev-col.sh
bindsym $mod+Shift+$Right   exec ~/.config/sway/scripts/send-next-col.sh

bindgesture swipe:4:up    exec ~/.config/sway/scripts/send-prev-row.sh
bindgesture swipe:4:down  exec ~/.config/sway/scripts/send-next-row.sh
bindgesture swipe:4:left  exec ~/.config/sway/scripts/send-prev-col.sh
bindgesture swipe:4:right exec ~/.config/sway/scripts/send-next-col.sh

bindgesture pinch:4:inward kill
bindgesture pinch:4:outward exec pkill rofi || rofi -show drun
bindgesture pinch:3 fullscreen

# Grid nav: Super + Alt + direction
bindsym $mod+Mod1+Left exec ~/.config/sway/scripts/focus-prev-col.sh
bindsym $mod+Mod1+Right exec ~/.config/sway/scripts/focus-next-col.sh
bindsym $mod+Mod1+Up    exec ~/.config/sway/scripts/focus-prev-row.sh
bindsym $mod+Mod1+Down  exec ~/.config/sway/scripts/focus-next-row.sh
bindsym $mod+Mod1+$Left exec ~/.config/sway/scripts/focus-prev-col.sh
bindsym $mod+Mod1+$Right exec ~/.config/sway/scripts/focus-next-col.sh
bindsym $mod+Mod1+$Up    exec ~/.config/sway/scripts/focus-prev-row.sh
bindsym $mod+Mod1+$Down  exec ~/.config/sway/scripts/focus-next-row.sh
